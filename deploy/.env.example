# 서버의 ~/horrorpond/.env 로 복사해서 채운다. 이 파일(.env)은 절대 git에 올리지 않는다.

# API 주소. 도메인이 없으면 <서버 공인 IP>.sslip.io (예: 152.70.0.1.sslip.io)
API_DOMAIN=

# 각각 긴 무작위 값 (예: openssl rand -base64 32)
POSTGRES_PASSWORD=
ADMIN_API_KEY=

# 선택: DeepL API 키 (한국어 소개가 없는 게임을 자동 번역). Free 키는 끝이 :fx, 월 50만 자 무료
DEEPL_API_KEY=

# 선택: rclone 원격 경로. 설정하면 매일 백업을 서버 밖으로도 복사한다 (예: gdrive:horrorpond-backup)
BACKUP_RCLONE_REMOTE=

# 선택: 앱 슬롯 하나의 메모리 상한 (기본 1536m). 메모리 2GB 서버(Lightsail 2GB 등)는 640m
APP_MEM_LIMIT=
